# Copy to .env.local for local development. On Vercel: Project → Settings → Environment
# Variables. Never commit real values. Only NEXT_PUBLIC_* reaches the browser — never put
# a secret behind that prefix. Every variable the code reads is listed here.

# ── Where the API is ────────────────────────────────────────────────────────────────
# The NestJS API. /api/* on this site is rewritten to it (next.config.ts), so auth cookies
# stay first-party. Read at BUILD time: changing it needs a new deployment.
# Default: the production API on Render. Local API: http://localhost:5000
API_URL=https://secret-santa-back-k0vs.onrender.com

# The same API, for the realtime socket — WebSockets can't go through the /api rewrite,
# so the browser connects to it directly. Public by design (no secret), inlined at BUILD
# time. Its origin must be allowed by the API's FRONTEND_URL / CORS_ORIGINS.
NEXT_PUBLIC_REALTIME_URL=https://secret-santa-back-k0vs.onrender.com

# ── Sign-in limits ──────────────────────────────────────────────────────────────────
# Server-only (src/proxy.ts): signs the visitor's IP on /api/auth/login, /api/auth/register
# and /api/auth/client-ip-check. Must be the SAME value as the API's CLIENT_IP_SIGNING_SECRET
# on Render. 32+ random bytes, base64url or hex — straight into the clipboard:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))" | clip
# Vercel production builds fail without a valid one (the live deployment stays); preview
# builds warn; locally nothing is signed, whatever is set here (signing needs Vercel's IP).
# Set it for the Production environment (and Preview, if previews should sign).
CLIENT_IP_SIGNING_SECRET=

# ── Public address (optional) ───────────────────────────────────────────────────────
# For absolute links in social previews (src/app/layout.tsx). Set only for a custom
# domain; otherwise Vercel's production domain is used, and locally http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── Set by Vercel itself — don't add them ───────────────────────────────────────────
# VERCEL=1, VERCEL_ENV (production | preview | development), VERCEL_PROJECT_PRODUCTION_URL
#
# NEXT_PUBLIC_API_URL is no longer read by the code and can be removed from .env.local.
